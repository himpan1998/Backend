        }
      },
      {
        type: 'buttons',
        dataField: 'Action',
        caption: 'Action',
        cssClass: 'actionArea',
        allowFiltering: false,
        allowSorting: false,
        visible: true,
        cellTemplate: function (container, options) {
          let data = options.row.data;
          // console.log('row-data', data);
          if (data) {
            var editButton = $('<button>')
              .text('View (Edit) ')
