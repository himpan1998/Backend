function loadSelectedLoadingPrograms(data) {
  return $(LOADING_PROGRAM_TABLE_IDENTIFIER).dxDataGrid({
    dataSource: data,
    KEYEXPR,
    scrolling: {
      mode: 'virtual'
    },
    remoteOperations: false,
    showBorders: true,
    sorting: {
      mode: 'none'
    },
    ...LOAD_PANEL_DX,
    rowDragging: {
      allowReordering: true,
      allowDropInsideItem: true,
      dropFeedbackMode: 'push',
      onReorder(e) {
        const fromIndex = e.fromIndex;
        const toIndex = e.toIndex;
        // Swap the positions of the dragged item and the target item in the data array
        const [movedItem] = data.splice(fromIndex, 1);
        data.splice(toIndex, 0, movedItem);
        // Update route_no values for the swapped items
        data.forEach((item, index) => {
          item.route_no = index + 1;
        });
        // Update the local storage and refresh the component
        localStorage.setItem(SELECTED_REQUISITION_LOCAL_STORAGE_IDENTIFIER, JSON.stringify(data));
        e.component.refresh();
      }
    },
    onToolbarPreparing: (e) => {
      e.toolbarOptions.items.unshift({
        location: 'before',
        template() {
          return $('<div>').addClass('text-info').append($('<span>').text('To adjust the routes, you can rearrange the row by dragging them'));
        }
      });
    },
    columns: [
      {
        dataField: 'route_no',
        // caption: 'Loading No',
        alignment: 'left'
      },
      {
        dataField: 'order_code',
        caption: 'Requisition ID',
        fixed: false
      },
      {
        dataField: 'dealer_name',
        allowEditing: false
      },
      {
        dataField: 'sap_code',
        caption: 'SAP Code',
        allowEditing: false,
        alignment: 'left'
      },
      {
        dataField: 'order_date',
        caption: 'Req. Date'
      },
      {
        dataField: 'source'
      },
      {
        dataField: 'order_qty',
        caption: 'Requisition Qty(ton)'
      },
      {
        dataField: 'consignee_details_view'
      },

      {
        dataField: 'consignee',
        caption: 'Select consignee',
        alignment: 'left',
        cellTemplate: function actionCellTemplate(container, options) {
          let selectBoxObj;
          $(container).dxSelectBox({
            value: options.value,
            dataSource: ACCOUNT_TYPES,
            onInitialized: (e) => {
              selectBoxObj = e.component;
            },
            onValueChanged: function (e, index) {
              // if ([40, 41].includes(e.value)) {
              //   initiaizeSubdealerPopup(e.value, options.data, selectBoxObj);
              // }
              if ([40].includes(e.value)) {
                initiaizeSubdealerPopup(e.value, options.data, selectBoxObj);
