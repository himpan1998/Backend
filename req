    labelMode: 'floating',
    formData: formData,
    colCount: 2,
    onInitialized: function (e) {
      formInstance = e.component;
    },

    onContentReady: function (e) {},
    onFieldDataChanged: (e) => {
      let component = e.component;

      if (e.dataField == 'consignee') {
        if (e.value != undefined) {
          let subdealerDeatils = dataset.subdealers.find((obj) => obj.subdealer_id == e.value);
          // console.log('subdealerDeatils', subdealerDeatils);
          let panEditor = component.getEditor('pan_number');
          panEditor?.option('value', subdealerDeatils.pan_no);

          let consigneePinEditor = component.getEditor('consignee_pincode');
          consigneePinEditor?.option('value', subdealerDeatils.address.pin);

          let addressLine1Editor = component.getEditor('address');
          addressLine1Editor?.option('value', subdealerDeatils.address.full_address);
        }
      }
      if (e.dataField === 'consignee_state_id') {
        let editor = component.getEditor('consignee_district_id');
        dxAreaHelper.getDistirct(e.value, editor);
      }

      let consigneeStateEditor = component.getEditor('consignee_state_id');
      let consigneeDistrictEditor = component.getEditor('consignee_district_id');
      if (e.dataField === 'consignee_pincode') {
        const pincode = e.value;
        if (pincode.length == 6) {
          $.ajax({
            url: route('webapi.order.get_state_district_by_pincode'),
            type: 'GET',
            data: { pincode: pincode },
            success: function (response) {
              consigneeStateEditor?.option('value', (response?.data?.data[0]?.state_id).toString());
              consigneeDistrictEditor?.option('value', response?.data?.data[0]?.district_id);
              if (response?.data?.data[0]?.state_id != null) {
                consigneeStateEditor?.option('readOnly', true);
                consigneeDistrictEditor?.option('readOnly', true);
              } else {
                consigneeStateEditor?.option('readOnly', false);
                consigneeDistrictEditor?.option('readOnly', false);
              }
            },
            error: function (error) {
              console.error('Error fetching state and district:', error);
            }
          });
        } else {
          consigneeStateEditor?.option('value', null);
          consigneeDistrictEditor?.option('value', null);
