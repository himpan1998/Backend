                const listData = $('#loading-program-dx .dx-texteditor-input');
                let countConsigneeSelectionValues = 0;
                for (var i = 0; i < listData.length; i++) {
                  // console.log('lostDaata value', listData[i].value);
                  if (listData[i].value) {
                    countConsigneeSelectionValues++;
                  }
                }

                if (listData.length == countConsigneeSelectionValues) {
                  const form = $(LOADING_PROGRAM_FORM_IDENTIFIER).dxForm('instance');
                  if (form.validate().isValid) {
                    const formData = form.option().formData;
                    const orderData = JSON.parse(localStorage.getItem(SELECTED_REQUISITION_LOCAL_STORAGE_IDENTIFIER));
                    const TotalOrderQunatity = orderData.reduce((acc, order) => acc + parseFloat(order.order_qty), 0);

                    if (TotalOrderQunatity > 40 && formData.material_type == 1) {
                      notify('Order qantity can not be more than 40 tons for this material type', 'warning');
                    }
                    if (TotalOrderQunatity > 30 && formData.material_type == 2) {
                      notify('Order qantity can not be more than 30 tons for this material type', 'warning');
                    }
                    if (TotalOrderQunatity > 40 && formData.material_type == 3) {
                      notify('Order qantity can not be more than 40 tons for this material type', 'warning');
                    }
                    const combinedData = {
                      orders: orderData,
                      ...formData
                    };
                    setLoadingProgram(combinedData);
                  }
                } else {
                  notify('You must select all consignee to continue', 'error');
                }
              }
            })
            .appendTo(itemElement);
        }
      }
    ]
  });
}

const setLoadingProgram = (payload) => {
  console.log('payload', payload);
  let URL = route(SET_LOADING_PROGRAM_ROUTE_IDENTIFIER);
  axios
    .post(URL, payload)
    .then(function (response) {
      console.log('response', response);
      notify('Loading program was updated sucessfully!!', 'success');
      $(LOADING_PROGRAM_POPUP_IDENTIFIER).dxPopup('instance').hide();
      $(REQUISITION_HISTORY_TABLE_IDENTIFIER).dxDataGrid('instance').refresh();
      localStorage.removeItem(SELECTED_REQUISITION_LOCAL_STORAGE_IDENTIFIER);
    })
    .catch(function (error) {
      console.log('error', error);
    });
};

