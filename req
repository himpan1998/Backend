function initiaizeSubdealerPopup(accountType = [], dataset, dxSelectBox) {
  const subdealerPopUpContentTemplate = function () {
    return $('<div/>').append(`<div id="${SUBDEALER_POPUP_FORM_IDENTIFIER.replace('#', '')}"></div>`);
  };

  subdealerPopup = $(SUBDEALER_KYC_INFO_POPUP_IDENTIFIER).dxPopup({
    contentTemplate: subdealerPopUpContentTemplate,
    width: 800,
    height: 390,
    showTitle: true,
    title: 'Subdealer KYC Information',
    visible: true,
    hideOnOutsideClick: false,
    showCloseButton: false,
    toolbarItems: [
      {
        toolbar: 'top',
        location: 'after',
        widget: 'dxButton',
        options: {
          type: 'close',
          icon: 'close',
          onClick: function () {
            dxSelectBox ? dxSelectBox.reset() : null;
            $(SUBDEALER_KYC_INFO_POPUP_IDENTIFIER).dxPopup('instance').hide();
          }
        }
      }
    ],
    position: {
      at: 'middle',
      my: 'center',
      collision: 'fit'
    },
    onHiding: function (e) {
      $('.main-sidebar').css('display', 'block');
    }
  });

  setTimeout(() => {
    loadSubdealerPopupForm(dataset, accountType);
  }, 100);
}

