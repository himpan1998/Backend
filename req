          if (status == 0) {
            let span = $(`<a class="text-info dx-link " onclick='window.open("${routeURL}")' target='_blank'>${options.data.order_code}</a>`).attr('href', 'javascript:void(0)');
            container.append(span);
          } else {
            let span = $(`<a class="text-info dx-link ">${options.data.order_code}</a>`).attr('href', 'javascript:void(0)');
            // let span=options.data.order_code
            container.append(span);
          }
        }
      },
      {
        dataField: 'order_date',
        fixed: false,
        caption: 'Requisition Date',
        width: 150,
        visible: true
      },
      {
        dataField: 'order_status_name',
        caption: 'Requisition Status',
        alignment: 'left',
        cellTemplate: (container, options) => {
